# Copy to .env.selfhost (gitignored) and pass it with --env-file, see docker-compose.selfhost.yml.
# POSTGRES_PASSWORD and BETTER_AUTH_SECRET are left empty on purpose: docker-compose.selfhost.yml
# fails fast (`${VAR:?…}`) if either is still unset when you run it, instead of quietly starting with
# a weak, guessable default.

# Password of the rock_ht Postgres user. Only read when the pgdata volume is first created.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs Better Auth sessions. Generate with: openssl rand -hex 32
# (hex, not base64: base64 can contain +, / and = which need extra quoting in a compose --env-file)
BETTER_AUTH_SECRET=
# The URL the app connects to (Settings → Sync → Self-hosted). For phone testing on your LAN:
# http://<LAN-IP>:3000. Anything reachable from the internet should be https behind a reverse proxy.
PUBLIC_URL=https://rock-ht.example.com
# Tag suffix of ghcr.io/13/rock_ht-web:selfhost-<this>: "latest", or a released version without its
# leading "v" (tag v1.2.0 -> "1.2.0"). See README "Upgrading" for how to pin and roll this forward.
ROCK_HT_VERSION=latest
# Host port for the web container (container port 3000).
WEB_PORT=3000
# Host interface the web container's port is published on. Default is all interfaces (0.0.0.0), fine
# for direct LAN/phone testing. Behind a reverse proxy (nginx, Caddy — see README), set this to
# 127.0.0.1 so only the proxy can reach the container.
WEB_BIND=0.0.0.0
# Allow creating new accounts via the mobile app's "Create account". Defaults to "true"; set to
# "false" once you've created your account(s) to close sign-up on a server reachable from the
# internet (existing accounts can still sign in).
ALLOW_SIGNUP=true
# Comma-separated IPs/CIDRs of reverse proxies in front of this server (e.g. 127.0.0.1, or your
# proxy's LAN IP). Leave empty if the container is reached directly (no proxy) or your proxy sets a
# single-value client-IP header (see README). Used to derive the real client IP for rate limiting.
TRUSTED_PROXIES=
