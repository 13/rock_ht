# Copy to .env.selfhost (gitignored) and pass it with --env-file, see docker-compose.selfhost.yml.

# Password of the rock_ht Postgres user. Only read when the pgdata volume is first created.
POSTGRES_PASSWORD=change-me
# Signs Better Auth sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# The URL the app connects to (Settings → Sync → Self-hosted). For phone testing on your LAN:
# http://<LAN-IP>:3000. Anything reachable from the internet should be https behind a reverse proxy.
PUBLIC_URL=https://rock-ht.example.com
# Tag of ghcr.io/13/rock_ht-web.
ROCK_HT_VERSION=latest
# Host port for the web container (container port 3000).
WEB_PORT=3000
